<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/v7_multi_root"
 android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
 android:padding="3dp" android:background="@drawable/widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/v7_multi_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
   android:text="CLASH TIMER HUB" android:textColor="#FFD783" android:textStyle="bold" android:textSize="12sp"
   android:singleLine="true" android:ellipsize="end"/>
  <TextView android:id="@+id/v7_multi_summary" android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:textColor="#BCA7D5" android:textSize="10sp" android:paddingRight="4dp"/>
  <TextView android:id="@+id/v7_multi_settings" android:layout_width="26dp" android:layout_height="18dp" android:text="⚙"
   android:gravity="center" android:textSize="15sp" android:textColor="#FFD783" android:contentDescription="Configure widget"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/v7_multi_rows" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="vertical"/>
 <TextView android:id="@+id/v7_multi_sync" android:layout_width="match_parent" android:layout_height="20dp"
  android:text="Sync OFF" android:textColor="#8BE3AD" android:textStyle="bold" android:textSize="11sp"
  android:gravity="center" android:background="@drawable/widget_row_background"/>
</LinearLayout>