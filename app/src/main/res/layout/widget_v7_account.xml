<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/v7_single_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
 android:padding="4dp" android:background="@drawable/widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:gravity="center_vertical">
  <TextView android:id="@+id/v7_single_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
   android:textSize="13sp" android:textColor="#FFD783" android:textStyle="bold" android:singleLine="true" android:ellipsize="end"/>
  <TextView android:id="@+id/v7_single_settings" android:layout_width="27dp" android:layout_height="23dp" android:text="⚙" android:textSize="17sp"
   android:textColor="#FFD783" android:gravity="center" android:contentDescription="Configure widget"/>
 </LinearLayout>
 <TextView android:id="@+id/v7_single_builders" android:layout_width="match_parent" android:layout_height="18dp"
  android:textSize="13sp" android:textColor="#8BE3AD" android:gravity="center_vertical" android:textStyle="bold"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="23dp" android:gravity="center_vertical">
  <TextView android:layout_width="45dp" android:layout_height="wrap_content" android:text="⚒" android:textColor="#BCA7D5" android:textSize="12sp"/>
  <Chronometer android:id="@+id/v7_single_builder_timer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
   android:textSize="12sp" android:textColor="#FFD783" android:singleLine="true"/>
  <TextView android:id="@+id/v7_single_builder_idle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
   android:text="—" android:textSize="12sp" android:textColor="#FFD783" android:visibility="gone"/>
  <TextView android:id="@+id/v7_single_builder_finish" android:layout_width="103dp" android:layout_height="wrap_content"
   android:gravity="end" android:textSize="10sp" android:textColor="#CBB5D9" android:singleLine="true"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/v7_single_lab_row" android:layout_width="match_parent" android:layout_height="23dp" android:gravity="center_vertical">
  <TextView android:id="@+id/v7_single_lab_count" android:layout_width="45dp" android:layout_height="wrap_content" android:text="🧙 0" android:textColor="#BCA7D5" android:textSize="11sp"/>
  <Chronometer android:id="@+id/v7_single_lab_timer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
   android:textSize="12sp" android:textColor="#FFD783" android:singleLine="true"/>
  <TextView android:id="@+id/v7_single_lab_idle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
   android:text="—" android:textSize="12sp" android:textColor="#FFD783" android:visibility="gone"/>
  <TextView android:id="@+id/v7_single_lab_finish" android:layout_width="103dp" android:layout_height="wrap_content"
   android:gravity="end" android:textSize="10sp" android:textColor="#CBB5D9" android:singleLine="true"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/v7_single_pet_row" android:layout_width="match_parent" android:layout_height="23dp" android:gravity="center_vertical">
  <TextView android:id="@+id/v7_single_pet_count" android:layout_width="45dp" android:layout_height="wrap_content" android:text="🐾 0" android:textColor="#BCA7D5" android:textSize="11sp"/>
  <Chronometer android:id="@+id/v7_single_pet_timer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
   android:textSize="12sp" android:textColor="#FFD783" android:singleLine="true"/>
  <TextView android:id="@+id/v7_single_pet_idle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
   android:text="—" android:textSize="12sp" android:textColor="#FFD783" android:visibility="gone"/>
  <TextView android:id="@+id/v7_single_pet_finish" android:layout_width="103dp" android:layout_height="wrap_content"
   android:gravity="end" android:textSize="10sp" android:textColor="#CBB5D9" android:singleLine="true"/>
 </LinearLayout>
 <TextView android:id="@+id/v7_single_sync" android:layout_width="match_parent" android:layout_height="18dp"
  android:gravity="center" android:textColor="#8BE3AD" android:textSize="12sp" android:textStyle="bold"
  android:background="@drawable/widget_row_background" android:text="Sync OFF"/>
</LinearLayout>