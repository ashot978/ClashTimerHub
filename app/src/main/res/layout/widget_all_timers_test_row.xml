<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/all_timer_row" android:layout_width="match_parent"
 android:layout_height="52dp" android:orientation="vertical"
 android:paddingLeft="6dp" android:paddingRight="6dp" android:paddingTop="3dp"
 android:paddingBottom="3dp" android:background="@drawable/widget_row_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="23dp"
  android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/all_timer_account" android:layout_width="79dp"
   android:layout_height="match_parent" android:gravity="center_vertical"
   android:text="Shotty" android:textColor="#FFFFFF" android:textStyle="bold"
   android:textSize="11sp" android:singleLine="true" android:ellipsize="end"/>
  <TextView android:id="@+id/all_timer_name" android:layout_width="0dp"
   android:layout_weight="1" android:layout_height="match_parent"
   android:gravity="center_vertical" android:text="Battle Drill"
   android:textColor="#FFFFFF" android:textSize="11sp"
   android:singleLine="true" android:ellipsize="end"/>
  <Chronometer android:id="@+id/all_timer_clock" android:layout_width="90dp"
   android:layout_height="match_parent" android:gravity="right|center_vertical"
   android:textSize="11sp" android:textColor="#FFD783"
   android:singleLine="true" android:includeFontPadding="false"/>
  <TextView android:id="@+id/all_timer_ready" android:layout_width="90dp"
   android:layout_height="match_parent" android:gravity="right|center_vertical"
   android:textSize="11sp" android:textColor="#8BE3AD"
   android:text="✓ Ready" android:visibility="gone"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="23dp"
  android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/all_timer_category" android:layout_width="0dp"
   android:layout_weight="1" android:layout_height="match_parent"
   android:gravity="center_vertical" android:text="Goblin research"
   android:textColor="#CBB5D9" android:textSize="10sp"
   android:singleLine="true" android:ellipsize="end"/>
  <TextView android:id="@+id/all_timer_boost" android:layout_width="95dp"
   android:layout_height="match_parent" android:gravity="center"
   android:text="⚡ 24× −20u" android:textColor="#8BE3AD"
   android:textSize="10sp" android:singleLine="true"/>
  <TextView android:id="@+id/all_timer_end" android:layout_width="94dp"
   android:layout_height="match_parent" android:gravity="right|center_vertical"
   android:text="17:02" android:textColor="#CBB5D9" android:textStyle="bold"
   android:textSize="10sp" android:singleLine="true"/>
 </LinearLayout>
</LinearLayout>