<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="6dp">
  <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
   android:text="⚔ CLASH TIMER HUB" android:textColor="#FFD783" android:textSize="15sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end"/>
  <TextView android:id="@+id/widget_summary" android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:textColor="#BCA7D5" android:textSize="10sp" android:singleLine="true" android:paddingRight="6dp"/>
  <TextView android:id="@+id/widget_settings" android:layout_width="30dp" android:layout_height="34dp" android:text="⚙" android:gravity="center"
   android:textColor="#FFD783" android:textSize="19sp" android:contentDescription="Widget instellen"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>

</LinearLayout>