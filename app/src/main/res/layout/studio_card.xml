<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/studio_card_root" android:layout_width="match_parent"
 android:layout_height="wrap_content" android:orientation="vertical"
 android:padding="5dp" android:layout_margin="2dp" android:background="#38284A">
 <TextView android:id="@+id/studio_card_name"
  android:layout_width="match_parent" android:layout_height="wrap_content"
  android:textColor="#FFD783" android:textStyle="bold" android:textSize="13sp"
  android:singleLine="true" android:ellipsize="end"/>
 <LinearLayout android:id="@+id/studio_card_fields"
  android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="vertical"/>
</LinearLayout>