<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/all_account_row" android:layout_width="match_parent"
 android:layout_height="44dp" android:layout_marginBottom="1dp"
 android:orientation="vertical" android:gravity="center_vertical"
 android:paddingLeft="4dp" android:paddingRight="4dp"
 android:background="@drawable/widget_row_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="20dp"
  android:gravity="center_vertical" android:orientation="horizontal">
  <TextView android:id="@+id/all_account_name"
   android:layout_width="83dp" android:layout_height="match_parent"
   android:gravity="center_vertical" android:text="Rushot"
   android:textSize="10sp" android:textColor="#FFFFFF"
   android:textStyle="bold" android:includeFontPadding="false"
   android:singleLine="true" android:ellipsize="end"/>
  <TextView android:id="@+id/all_account_builders"
   android:layout_width="56dp" android:layout_height="match_parent"
   android:gravity="center_vertical" android:text="0✓ 7⚒"
   android:textSize="9sp" android:textColor="#8BE3AD"
   android:includeFontPadding="false" android:singleLine="true"/>
  <TextView android:id="@+id/all_account_helpers"
   android:layout_width="0dp" android:layout_weight="1"
   android:layout_height="match_parent" android:gravity="center_vertical"
   android:text="🤝 0/2 · 17h" android:textSize="9sp"
   android:textColor="#8BE3AD" android:includeFontPadding="false"
   android:singleLine="true" android:ellipsize="end"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="22dp"
  android:gravity="center_vertical" android:orientation="horizontal"
  android:baselineAligned="false">
  <LinearLayout android:layout_width="0dp" android:layout_weight="1"
   android:layout_height="22dp" android:orientation="horizontal"
   android:gravity="center_vertical" android:baselineAligned="false">
   <TextView android:id="@+id/all_account_builder_icon"
    android:layout_width="14dp" android:layout_height="match_parent"
    android:gravity="center_vertical" android:text="⚒"
    android:textSize="9sp" android:includeFontPadding="false"
    android:textColor="#D6BCEA"/>
   <Chronometer android:id="@+id/all_account_builder_clock"
    android:layout_width="0dp" android:layout_weight="1.05"
    android:layout_height="match_parent" android:gravity="center_vertical"
    android:textSize="9sp" android:textColor="#FFD783"
    android:includeFontPadding="false" android:singleLine="true"
    android:ellipsize="end"/>
   <TextView android:id="@+id/all_account_builder_idle"
    android:layout_width="0dp" android:layout_weight="1.05"
    android:layout_height="match_parent" android:gravity="center_vertical"
    android:textSize="9sp" android:text="—" android:textColor="#CBB5D9"
    android:visibility="gone" android:singleLine="true"/>
   <TextView android:id="@+id/all_account_builder_end"
    android:layout_width="0dp" android:layout_weight="1.15"
    android:layout_height="match_parent" android:gravity="right|center_vertical"
    android:textSize="9sp" android:text="17:29" android:textColor="#CBB5D9"
    android:includeFontPadding="false" android:singleLine="true"
    android:ellipsize="end"/>
 </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1"
   android:layout_height="22dp" android:orientation="horizontal"
   android:gravity="center_vertical" android:baselineAligned="false">
   <TextView android:id="@+id/all_account_lab_icon"
    android:layout_width="14dp" android:layout_height="match_parent"
    android:gravity="center_vertical" android:text="🧙"
    android:textSize="9sp" android:includeFontPadding="false"
    android:textColor="#D6BCEA"/>
   <Chronometer android:id="@+id/all_account_lab_clock"
    android:layout_width="0dp" android:layout_weight="1.05"
    android:layout_height="match_parent" android:gravity="center_vertical"
    android:textSize="9sp" android:textColor="#FFD783"
    android:includeFontPadding="false" android:singleLine="true"
    android:ellipsize="end"/>
   <TextView android:id="@+id/all_account_lab_idle"
    android:layout_width="0dp" android:layout_weight="1.05"
    android:layout_height="match_parent" android:gravity="center_vertical"
    android:textSize="9sp" android:text="—" android:textColor="#CBB5D9"
    android:visibility="gone" android:singleLine="true"/>
   <TextView android:id="@+id/all_account_lab_end"
    android:layout_width="0dp" android:layout_weight="1.15"
    android:layout_height="match_parent" android:gravity="right|center_vertical"
    android:textSize="9sp" android:text="17:29" android:textColor="#CBB5D9"
    android:includeFontPadding="false" android:singleLine="true"
    android:ellipsize="end"/>
 </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1"
   android:layout_height="22dp" android:orientation="horizontal"
   android:gravity="center_vertical" android:baselineAligned="false">
   <TextView android:id="@+id/all_account_pet_icon"
    android:layout_width="14dp" android:layout_height="match_parent"
    android:gravity="center_vertical" android:text="🐾"
    android:textSize="9sp" android:includeFontPadding="false"
    android:textColor="#D6BCEA"/>
   <Chronometer android:id="@+id/all_account_pet_clock"
    android:layout_width="0dp" android:layout_weight="1.05"
    android:layout_height="match_parent" android:gravity="center_vertical"
    android:textSize="9sp" android:textColor="#FFD783"
    android:includeFontPadding="false" android:singleLine="true"
    android:ellipsize="end"/>
   <TextView android:id="@+id/all_account_pet_idle"
    android:layout_width="0dp" android:layout_weight="1.05"
    android:layout_height="match_parent" android:gravity="center_vertical"
    android:textSize="9sp" android:text="—" android:textColor="#CBB5D9"
    android:visibility="gone" android:singleLine="true"/>
   <TextView android:id="@+id/all_account_pet_end"
    android:layout_width="0dp" android:layout_weight="1.15"
    android:layout_height="match_parent" android:gravity="right|center_vertical"
    android:textSize="9sp" android:text="17:29" android:textColor="#CBB5D9"
    android:includeFontPadding="false" android:singleLine="true"
    android:ellipsize="end"/>
 </LinearLayout>
 </LinearLayout>
</LinearLayout>