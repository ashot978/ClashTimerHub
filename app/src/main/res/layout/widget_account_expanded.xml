<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_account_root"
 android:layout_width="match_parent" android:layout_height="53dp" android:orientation="vertical"
 android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="6dp" android:layout_marginBottom="3dp"
 android:background="@drawable/widget_row_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/widget_account_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
   android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp" android:singleLine="true" android:ellipsize="end"/>
  <TextView android:id="@+id/widget_ready" android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:textColor="#8BE3AD" android:textSize="11sp" android:paddingRight="7dp" android:visibility="gone"/>
  <Chronometer android:id="@+id/widget_timer" android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:textColor="#FFD783" android:textSize="13sp" android:singleLine="true"/>
  <TextView android:id="@+id/widget_idle" android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:textColor="#BBA7D1" android:textSize="11sp" android:text="—" android:visibility="gone"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:textColor="#C9B9DF" android:textSize="10sp" android:singleLine="true" android:ellipsize="end" android:paddingTop="2dp"/>
</LinearLayout>