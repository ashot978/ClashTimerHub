<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_account_root" android:layout_width="match_parent" android:layout_height="23dp"
 android:layout_marginBottom="1dp" android:orientation="horizontal" android:gravity="center_vertical"
 android:paddingLeft="6dp" android:paddingRight="6dp" android:background="@drawable/widget_row_background">
 <TextView android:id="@+id/v7_wide_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
  android:textSize="11sp" android:textColor="#FFFFFF" android:textStyle="bold" android:singleLine="true" android:ellipsize="end"/>
 <TextView android:id="@+id/v7_wide_builders" android:layout_width="65dp" android:layout_height="wrap_content"
  android:textSize="10sp" android:textColor="#8BE3AD" android:gravity="center" android:singleLine="true"/>
 <LinearLayout android:id="@+id/v7_wide_lab_group" android:layout_width="77dp" android:layout_height="wrap_content" android:gravity="center">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚗ " android:textSize="10sp" android:textColor="#D6BCEA"/>
  <Chronometer android:id="@+id/v7_wide_lab_timer" android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:textSize="10sp" android:textColor="#D6BCEA" android:singleLine="true"/>
  <TextView android:id="@+id/v7_wide_lab_idle" android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:text="—" android:textSize="10sp" android:textColor="#BCA7D5" android:visibility="gone"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/v7_wide_pet_group" android:layout_width="77dp" android:layout_height="wrap_content" android:gravity="center">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🐾 " android:textSize="10sp" android:textColor="#D6BCEA"/>
  <Chronometer android:id="@+id/v7_wide_pet_timer" android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:textSize="10sp" android:textColor="#D6BCEA" android:singleLine="true"/>
  <TextView android:id="@+id/v7_wide_pet_idle" android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:text="—" android:textSize="10sp" android:textColor="#BCA7D5" android:visibility="gone"/>
 </LinearLayout>
 <Chronometer android:id="@+id/v7_wide_builder_timer" android:layout_width="90dp" android:layout_height="wrap_content"
  android:textSize="11sp" android:textColor="#FFD783" android:gravity="end" android:singleLine="true"/>
 <TextView android:id="@+id/v7_wide_builder_idle" android:layout_width="90dp" android:layout_height="wrap_content"
  android:textSize="11sp" android:textColor="#FFD783" android:gravity="end" android:visibility="gone"/>
 <TextView android:id="@+id/v7_wide_finish" android:layout_width="69dp" android:layout_height="wrap_content"
  android:textSize="10sp" android:textColor="#CBB5D9" android:gravity="end" android:singleLine="true"/>
</LinearLayout>