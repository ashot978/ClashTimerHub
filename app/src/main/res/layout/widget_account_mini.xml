<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_account_root"
 android:layout_width="match_parent" android:layout_height="21dp"
 android:layout_marginBottom="1dp" android:orientation="horizontal"
 android:gravity="center_vertical" android:paddingLeft="5dp" android:paddingRight="5dp"
 android:background="@drawable/widget_row_background">
 <TextView android:id="@+id/widget_account_name"
  android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
  android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="11sp"
  android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false"/>
 <TextView android:id="@+id/widget_ready"
  android:layout_width="wrap_content" android:layout_height="wrap_content"
  android:textColor="#8BE3AD" android:textSize="9sp" android:paddingRight="3dp"
  android:visibility="gone" android:includeFontPadding="false"/>
 <Chronometer android:id="@+id/widget_timer"
  android:layout_width="wrap_content" android:layout_height="wrap_content"
  android:textColor="#FFD783" android:textSize="10sp" android:fontFamily="sans-medium"
  android:singleLine="true" android:includeFontPadding="false"/>
 <TextView android:id="@+id/widget_idle"
  android:layout_width="wrap_content" android:layout_height="wrap_content"
  android:textColor="#8BE3AD" android:textSize="10sp" android:text="—"
  android:visibility="gone" android:includeFontPadding="false"/>
</LinearLayout>
