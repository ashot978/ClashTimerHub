<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="4dp" android:background="@drawable/widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="16dp"
  android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/v7_mini_title"
   android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
   android:text="Ashot" android:textColor="#FFD783" android:textSize="10sp" android:textStyle="bold"
   android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false"/>
  <TextView android:id="@+id/v7_mini_settings" android:layout_width="16dp" android:layout_height="16dp"
   android:text="⚙" android:textSize="12sp" android:textColor="#BCA7D5"
   android:gravity="center" android:contentDescription="Configure account"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/v7_mini_body" android:layout_width="match_parent"
  android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
   android:gravity="center" android:orientation="horizontal">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:text="⚒" android:textColor="#DCC5EE" android:textSize="13sp" android:paddingRight="3dp"/>
   <Chronometer android:id="@+id/v7_mini_timer" android:layout_width="wrap_content"
    android:layout_height="wrap_content" android:text="00:00" android:textColor="#FFD783"
    android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false" android:singleLine="true"/>
   <TextView android:id="@+id/v7_mini_idle" android:layout_width="wrap_content"
    android:layout_height="wrap_content" android:text="—" android:textColor="#8BE3AD"
    android:textSize="16sp" android:visibility="gone" android:singleLine="true"/>
  </LinearLayout>
  <TextView android:id="@+id/v7_mini_finish" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:textColor="#CBB5D9" android:textSize="10sp"
   android:gravity="center" android:singleLine="true" android:includeFontPadding="false"/>
  <TextView android:id="@+id/v7_mini_status" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:textColor="#8BE3AD" android:textSize="10sp"
   android:gravity="center" android:singleLine="true" android:includeFontPadding="false"/>
 </LinearLayout>
</LinearLayout>