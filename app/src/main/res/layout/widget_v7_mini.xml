<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
 android:padding="4dp" android:background="@drawable/widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="20dp" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/v7_mini_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
   android:textColor="#FFD783" android:textSize="9sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end"/>
  <TextView android:id="@+id/v7_mini_settings" android:layout_width="19dp" android:layout_height="20dp" android:text="⚙"
   android:textColor="#BCA7D5" android:textSize="14sp" android:gravity="center" android:contentDescription="Configure account"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/v7_mini_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
   android:orientation="vertical" android:gravity="center">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚒"
    android:textColor="#DCC5EE" android:textSize="15sp"/>
   <TextView android:id="@+id/v7_mini_ready" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0"
    android:paddingLeft="2dp" android:textColor="#8BE3AD" android:textStyle="bold" android:textSize="23sp"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center">
   <TextView android:id="@+id/v7_mini_lab" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:textColor="#E1CEEF" android:textSize="10sp" android:paddingRight="4dp"/>
   <TextView android:id="@+id/v7_mini_pet" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:textColor="#E1CEEF" android:textSize="10sp"/>
  </LinearLayout>
 </LinearLayout>
</LinearLayout>