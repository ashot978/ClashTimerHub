<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="@android:color/transparent">
 <!-- The visible panel wraps its content. Extra launcher height remains
      transparent rather than producing a large empty purple rectangle. -->
 <LinearLayout android:id="@+id/all_timers_panel"
  android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="vertical" android:padding="4dp"
  android:background="@drawable/widget_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="26dp"
   android:orientation="horizontal" android:gravity="center_vertical"
   android:background="@drawable/widget_row_background">
   <TextView android:id="@+id/all_timers_title"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center_vertical" android:paddingLeft="8dp"
    android:text="All timers" android:textSize="12sp"
    android:textColor="#FFD783" android:textStyle="bold"/>
  </LinearLayout>
  <TextView android:id="@+id/all_timers_summary" android:layout_width="match_parent"
   android:layout_height="19dp" android:gravity="center_vertical"
   android:paddingLeft="8dp" android:singleLine="true"
   android:ellipsize="end" android:text="7 accounts · green = potion"
   android:textColor="#CBB5D9" android:textSize="10sp"/>
  <ListView android:id="@+id/all_timers_list"
   android:layout_width="match_parent" android:layout_height="210dp"
   android:divider="@android:color/transparent" android:dividerHeight="1dp"
   android:scrollbars="vertical" android:fadeScrollbars="true"
   android:cacheColorHint="#00000000"/>
  <TextView android:id="@+id/all_timers_empty"
   android:layout_width="match_parent" android:layout_height="wrap_content"
   android:padding="12dp" android:gravity="center" android:visibility="gone"
   android:text="Synchroniseer een account"
   android:textColor="#CBB5D9" android:textSize="11sp"/>
  <!-- Settings belongs at the BOTTOM RIGHT, with an accessible tap target. -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="42dp"
   android:orientation="horizontal" android:gravity="center_vertical"
   android:background="@drawable/widget_row_background">
   <TextView android:id="@+id/all_timers_sync"
    android:layout_width="0dp" android:layout_weight="1"
    android:layout_height="match_parent" android:gravity="center"
    android:text="Sync ON" android:contentDescription="Toggle floating Sync"
    android:textSize="13sp" android:textColor="#8BE3AD" android:textStyle="bold"/>
   <TextView android:id="@+id/all_timers_settings"
    android:layout_width="48dp" android:layout_height="match_parent"
    android:gravity="center" android:text="⚙"
    android:textColor="#FFD783" android:textSize="24sp"
    android:contentDescription="Configure All Timers widget"/>
  </LinearLayout>
 </LinearLayout>
</FrameLayout>