<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="4dp" android:background="@drawable/widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="26dp"
  android:orientation="horizontal" android:gravity="center_vertical"
  android:background="@drawable/widget_row_background">
  <TextView android:id="@+id/all_timers_title" android:layout_width="0dp"
   android:layout_weight="1" android:layout_height="match_parent"
   android:gravity="center_vertical" android:paddingLeft="8dp"
   android:text="All timers" android:textSize="12sp"
   android:textColor="#FFD783" android:textStyle="bold"/>
  <TextView android:id="@+id/all_timers_open" android:layout_width="42dp"
   android:layout_height="24dp" android:gravity="center"
   android:background="@drawable/widget_boost_action"
   android:text="↗" android:textColor="#FFFFFF" android:textSize="18sp"/>
 </LinearLayout>
 <TextView android:id="@+id/all_timers_summary" android:layout_width="match_parent"
  android:layout_height="19dp" android:gravity="center_vertical"
  android:paddingLeft="8dp" android:singleLine="true"
  android:text="7 accounts · groen = potion"
  android:textColor="#CBB5D9" android:textSize="10sp"/>
 <ListView android:id="@+id/all_timers_list" android:layout_width="match_parent"
  android:layout_height="0dp" android:layout_weight="1"
  android:divider="@android:color/transparent" android:dividerHeight="1dp"
  android:scrollbars="vertical" android:fadeScrollbars="true" android:cacheColorHint="#00000000"/>
 <TextView android:id="@+id/all_timers_empty" android:layout_width="match_parent"
  android:layout_height="0dp" android:layout_weight="1" android:gravity="center"
  android:text="Synchroniseer een account" android:textColor="#CBB5D9" android:textSize="11sp"/>
 <TextView android:id="@+id/all_timers_sync"
  android:layout_width="match_parent" android:layout_height="27dp" android:gravity="center"
  android:background="@drawable/widget_row_background" android:text="Sync OFF"
  android:textSize="13sp" android:textColor="#8BE3AD" android:textStyle="bold"/>
</LinearLayout>