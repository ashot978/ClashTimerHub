<manifest xmlns:android="http://schemas.android.com/apk/res/android">
<uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
<application android:label="Clash Timer Hub" android:icon="@drawable/clash_hub_icon" android:theme="@android:style/Theme.Material.NoActionBar">
<activity android:name="nl.clashtimerhub.v2.MainActivity" android:exported="true">
<intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
</activity>
<receiver android:name=".BuilderAlarm" android:exported="false"/>
<receiver android:name=".TimerWidget" android:exported="true">
<intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
<meta-data android:name="android.appwidget.provider" android:resource="@xml/builder_widget_info"/>
</receiver>
</application></manifest>